# MongoDB connection string used by Mongoose.
MONGODB_URI=mongodb+srv://hossainmdrobin9677_db_user:jNhgF6JvQDPyPwOU@cluster0.pa27ohc.mongodb.net/proagent?appName=Cluster0

# Secret used to sign verification cookies and HMAC-hash OTP codes.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-character-minimum-random-secret

# bcrypt cost factor (10-15). Higher is slower and safer.
BCRYPT_ROUNDS=12

# Absolute URL of the app, used in email links and metadata.
APP_URL=http://localhost:3000

# Optional base URL for the RTK Query API client.
# NEXT_PUBLIC_API_URL=/api

# SMTP delivery. Leave SMTP_HOST unset to log OTPs to the server console in
# development instead of sending email (the code is returned as `devOtp`).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SaadAgent <no-reply@saadagent.dev>

# ---------------------------------------------------------------------------
# Social sign-in (OAuth 2.0 authorization code + PKCE)
# ---------------------------------------------------------------------------
# Each provider is optional. A provider only appears on the login and sign-up
# screens once BOTH its client id and client secret are set, and any button for
# a provider that is not configured returns `not_configured`.
#
# Register the callback URL below with each provider, using the exact value of
# APP_URL above:
#   {APP_URL}/api/auth/oauth/google/callback
#   {APP_URL}/api/auth/oauth/facebook/callback
#   {APP_URL}/api/auth/oauth/github/callback
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# Endpoint overrides are optional and only needed for tests or self-hosted
# proxies. When omitted the provider defaults from lib/oauth/providers.ts are
# used.
# GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# FACEBOOK_AUTHORIZE_URL=https://www.facebook.com/v21.0/dialog/oauth
# FACEBOOK_TOKEN_URL=https://graph.facebook.com/v21.0/oauth/access_token
# FACEBOOK_USERINFO_URL=https://graph.facebook.com/v21.0/me

# GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_USERINFO_URL=https://api.github.com/user
# GITHUB_USER_EMAILS_URL=https://api.github.com/user/emails
